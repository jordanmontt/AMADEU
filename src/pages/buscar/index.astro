---
/**
 * Site search with Pagefind (RF-35, ADR 0014): the index is built after `astro build` and
 * searched in the browser. The UI follows the page language (Spanish).
 */
import PageBand from '../../components/PageBand.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { es } from '../../i18n/es';
---

<BaseLayout title={es.search.title}>
  <PageBand title={es.search.title} subtitle={es.search.intro} tone="sky" />
  <div class="search" data-pagefind-ignore="all">
    <div id="search"></div>
    <noscript>
      <p>{es.search.noScript}</p>
    </noscript>
  </div>
  <link rel="stylesheet" href="/pagefind/pagefind-ui.css" />
</BaseLayout>

<script>
  /*
   * Starts Pagefind's search box each time this page is shown. Navigation is client-side
   * (ClientRouter), which runs a page's inline scripts without waiting for its external ones,
   * so Pagefind's script is loaded here, once, and the box is created when it is ready.
   * Pagefind's files only exist in a build (`npm run build`), not under `astro dev`.
   */
  interface PagefindUIOptions {
    element: string;
    showSubResults: boolean;
    showImages: boolean;
  }
  type PagefindUIConstructor = new (options: PagefindUIOptions) => unknown;

  let pagefindUI: Promise<PagefindUIConstructor> | undefined;

  function loadPagefindUI(): Promise<PagefindUIConstructor> {
    pagefindUI ??= new Promise((resolve, reject) => {
      const script = document.createElement('script');
      script.src = '/pagefind/pagefind-ui.js';
      script.addEventListener('load', () => {
        resolve((window as unknown as { PagefindUI: PagefindUIConstructor }).PagefindUI);
      });
      script.addEventListener('error', () => {
        reject(new Error('Could not load /pagefind/pagefind-ui.js'));
      });
      document.head.append(script);
    });
    return pagefindUI;
  }

  document.addEventListener('astro:page-load', () => {
    if (document.querySelector('#search') === null) {
      return;
    }
    void loadPagefindUI().then((PagefindUI) => {
      new PagefindUI({ element: '#search', showSubResults: true, showImages: false });
    });
  });
</script>

<style>
  .search {
    padding: 2.5rem var(--gutter) 0;
    max-width: 48rem;
    --pagefind-ui-scale: 1;
    --pagefind-ui-primary: var(--ink);
    --pagefind-ui-text: var(--ink);
    --pagefind-ui-background: var(--paper);
    --pagefind-ui-border: var(--frame);
    --pagefind-ui-tag: var(--sky);
    --pagefind-ui-border-width: 3px;
    --pagefind-ui-border-radius: 0;
    --pagefind-ui-font: var(--font-text);
  }
</style>
