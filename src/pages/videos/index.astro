---
import PageBand from '../../components/PageBand.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { catalog } from '../../data/catalog';
import { es } from '../../i18n/es';
import { formatArchiveDate, formatDuration } from '../../lib/format';
import { videoPath } from '../../lib/routes';

const videos = (await catalog()).videos();
---

<BaseLayout title={es.videos.title}>
  <PageBand title={es.videos.title} subtitle={es.videos.intro} tone="sky" />
  <div class="videos">
    {videos.length === 0 ? (
      <p class="empty">{es.videos.empty}</p>
    ) : (
      <ul>
        {videos.map((video) => (
          <li>
            <a href={videoPath(video)}>{video.data.title}</a>
            <span>
              {[
                video.data.series,
                video.data.date && formatArchiveDate(video.data.date),
                video.data.durationSeconds && formatDuration(video.data.durationSeconds),
              ]
                .filter((part) => part !== undefined)
                .join(', ')}
            </span>
          </li>
        ))}
      </ul>
    )}
  </div>
</BaseLayout>

<style>
  .videos {
    padding: 2.5rem var(--gutter) 0;
    max-width: 48rem;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  li {
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--rule);
  }
  li a {
    font-family: var(--font-display);
    font-size: var(--step-1);
  }
  li span {
    display: block;
    color: var(--ink-soft);
  }
  .empty {
    border: 2px dashed var(--frame-soft);
    padding: 1rem 1.25rem;
    color: var(--ink-soft);
    max-width: var(--measure-prose);
  }
</style>
