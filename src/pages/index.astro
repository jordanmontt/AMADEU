---
import FramedArtwork from '../components/FramedArtwork.astro';
import AnimatedDrawing from '../components/animations/AnimatedDrawing.astro';
import WorkCard from '../components/WorkCard.astro';
import PlayerButton from '../components/player/PlayerButton.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { artworkImage, catalog } from '../data/catalog';
import { es } from '../i18n/es';
import { formatArchiveDate, formatDuration } from '../lib/format';
import { HOME_DRAWING, animationOf } from '../lib/animations/registry';
import { recordingTrack } from '../lib/player/track';
import { artworkPath, textPath, workPath } from '../lib/routes';
import { Image } from 'astro:assets';

const archive = await catalog();
const works = archive.works();
const [featured] = archive.publishedWorks();
/**
 * The home page opens with "Cordillera Real", animated (RF-11): La Paz's snow-capped range,
 * where the Illimani stands. Until its rights are cleared, the work's cover is shown still.
 */
const homeDrawing = archive.artwork(HOME_DRAWING);
const homeAnimation = animationOf(HOME_DRAWING);
const cover = featured === undefined ? undefined : archive.coverOf(featured);
const art = homeDrawing ?? cover;
const artImage = art === undefined ? undefined : await artworkImage(art);

/** Songs that can be both heard and seen, each with its first drawing and main recording. */
const showcase = (featured === undefined ? [] : archive.showcaseTexts(featured))
  .slice(0, 4)
  .flatMap((text) => {
    const versions = archive.recordingVersions(text);
    const [drawing] = archive.illustrationsOf(text);
    return versions.kind === 'available' && drawing !== undefined
      ? [
          {
            text,
            recording: versions.primary,
            drawing,
            href: textPath(archive.workOf(text), text),
          },
        ]
      : [];
  });
const drawings = archive
  .artworks()
  .filter((artwork) => artwork.data.kind === 'drawing' && artwork.data.sheet === undefined)
  .slice(0, 6);
---

<BaseLayout>
  <section class="hero" aria-labelledby="site-title">
    <div class="intro">
      <h1 id="site-title">{es.home.title}</h1>
      <p class="tagline">{es.home.subtitle}</p>
      <p>{es.home.lede}</p>
      {featured !== undefined && (
        <a class="enter" href={workPath(featured)}>
          {es.home.enterWork} <em>{featured.data.title}</em>
        </a>
      )}
    </div>
    {art !== undefined && artImage !== undefined && (
      <figure class="art">
        {homeDrawing !== undefined && homeAnimation !== undefined ? (
          <AnimatedDrawing
            artwork={homeDrawing}
            animation={homeAnimation}
            sizes="(min-width: 900px) 40vw, 100vw"
            widths={[480, 800, 1200, 1600]}
            loading="eager"
          />
        ) : (
          <Image
            src={artImage}
            alt={art.data.alt}
            widths={[480, 800, 1200, 1600]}
            sizes="(min-width: 900px) 40vw, 100vw"
            loading="eager"
          />
        )}
        <figcaption>
          <a href={artworkPath(art)}>
            {[
              `«${art.data.title}»`,
              art.data.technique?.toLowerCase(),
              art.data.place,
              art.data.date === undefined ? undefined : formatArchiveDate(art.data.date),
            ]
              .filter((part) => part !== undefined)
              .join(', ')}
          </a>
        </figcaption>
      </figure>
    )}
  </section>

  {showcase.length > 0 && (
    <section class="showcase" aria-labelledby="listen-heading">
      <div class="section-head">
        <h2 id="listen-heading">{es.home.listenHeading}</h2>
        <a href="/escuchar/">{es.home.listenAll}</a>
      </div>
      <ul>
        {showcase.map(({ text, recording, drawing, href }) => (
          <li>
            <div class="picture">
              <FramedArtwork
                artwork={drawing}
                sizes="(min-width: 900px) 22vw, (min-width: 560px) 45vw, 90vw"
                caption={false}
                link={false}
                widths={[320, 480, 720]}
              />
              <PlayerButton
                action="play"
                tracks={[recordingTrack(recording, href)]}
                label={es.recording.play(text.data.title)}
                pauseLabel={es.recording.pause(text.data.title)}
                class="showcase-play"
              />
            </div>
            <h3>
              <a href={href}>{text.data.title}</a>
            </h3>
            <p>
              {recording.data.collection}, {formatDuration(recording.data.durationSeconds)}
            </p>
          </li>
        ))}
      </ul>
    </section>
  )}

  {drawings.length > 0 && (
    <section class="drawings" aria-labelledby="drawings-heading">
      <div class="section-head">
        <h2 id="drawings-heading">{es.home.galleryHeading}</h2>
        <a href="/galeria/">{es.home.galleryAll}</a>
      </div>
      <div class="strip">
        {drawings.map((artwork) => (
          <FramedArtwork
            artwork={artwork}
            sizes="(min-width: 900px) 16vw, 45vw"
            widths={[240, 360, 540]}
          />
        ))}
      </div>
    </section>
  )}

  <section class="works" aria-labelledby="works-heading">
    <h2 id="works-heading">{es.home.worksHeading}</h2>
    <div class="grid">
      {works.map((work) => (
        <WorkCard work={work} />
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.9fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
    padding: clamp(2rem, 5vw, 4rem) var(--gutter) 0;
  }
  .intro {
    max-width: 34rem;
  }
  h1 {
    font-size: clamp(3rem, 7vw, 5.5rem);
    line-height: 1;
    margin: 0 0 1rem;
  }
  .tagline {
    font-style: italic;
    font-size: var(--step-1);
    margin: 0 0 1rem;
  }
  .intro p {
    margin: 0 0 1.5rem;
  }
  .enter {
    display: inline-block;
    background: var(--ochre);
    color: var(--ink);
    font-weight: 600;
    text-decoration: none;
    padding: 0.75rem 1.2rem;
  }
  .enter:hover {
    background: var(--ink);
    color: var(--paper);
  }
  .art {
    margin: 0;
    /* A portrait painting: never taller than the window. */
    width: min(100%, calc(82vh * 0.75));
    justify-self: end;
  }
  .art :global(img),
  .art :global(animated-drawing) {
    display: block;
    width: 100%;
    height: auto;
  }
  .art figcaption {
    margin-top: 0.5rem;
    font-style: italic;
    font-size: var(--step--1);
  }
  .works,
  .showcase,
  .drawings {
    padding: 3.5rem var(--gutter) 0;
  }
  .section-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    margin-bottom: 1.5rem;
  }
  .section-head h2,
  .works h2 {
    font-size: 2rem;
    margin: 0;
  }
  .works h2 {
    margin-bottom: 1.5rem;
  }
  .showcase ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(13rem, 1fr));
    gap: 2rem 1.5rem;
  }
  .showcase li :global(img) {
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: top;
  }
  .showcase h3 {
    font-size: 1.3rem;
    margin: 0.85rem 0 0.25rem;
  }
  .showcase h3 a {
    text-decoration: none;
  }
  .showcase h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .showcase li {
    position: relative;
  }
  .picture {
    position: relative;
  }
  .picture :global(.showcase-play) {
    position: absolute;
    z-index: 1;
    left: 0.75rem;
    bottom: 0.75rem;
    width: 3.25rem;
    height: 3.25rem;
    box-shadow: 0 0 0 3px var(--paper);
  }
  .showcase li:hover :global(img) {
    border-color: var(--ochre);
  }
  .showcase p {
    margin: 0;
    color: var(--ink-soft);
    font-size: var(--step--1);
  }
  .strip {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(10rem, 1fr));
    gap: 1.25rem;
  }
  .strip :global(img) {
    aspect-ratio: 1;
    object-fit: cover;
  }
  .strip :global(figcaption) {
    display: none;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
    gap: 1.5rem;
  }
  @media (max-width: 760px) {
    .hero {
      grid-template-columns: 1fr;
    }
    .art {
      justify-self: stretch;
      width: 100%;
    }
  }
</style>
