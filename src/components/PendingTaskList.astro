---
/**
 * The Foundation's pending tasks, grouped by kind (RF-72). Each task links to the entry in
 * the admin panel, where fixing the content removes the task at the next publication.
 */
import { es } from '../i18n/es';
import type { PendingTaskGroup } from '../lib/content/pending-tasks';
import { adminEditPath } from '../lib/routes';

interface Props {
  groups: readonly PendingTaskGroup[];
}

const { groups } = Astro.props;
const strings = es.pendingTasks;
const total = groups.reduce((sum, group) => sum + group.tasks.length, 0);
---

<p>{total === 0 ? strings.nothingPending : strings.total(total)}</p>
{groups.map((group) => (
  <section aria-labelledby={`tasks-${group.kind}`}>
    <h2 id={`tasks-${group.kind}`}>
      {strings.kinds[group.kind].title} ({group.tasks.length})
    </h2>
    <p>{strings.kinds[group.kind].help}</p>
    <ul>
      {group.tasks.map((task) => (
        <li>
          <a href={adminEditPath(task.collection, task.id)}>
            {strings.collections[task.collection]}: {task.title}
          </a>
          {task.detail !== undefined && <p>{task.detail}</p>}
        </li>
      ))}
    </ul>
  </section>
))}
