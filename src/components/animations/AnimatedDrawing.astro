---
/**
 * A drawing brought to life (RF-50 to RF-52, ADR 0051, ADR 0054): its layers, cut from the
 * scan by `scripts/animations/build.ts`, stacked in one box. The background carries the
 * artwork's alternative text; the other layers are decorative.
 *
 * The parts move as their description says (strum, sway or drift): while a song plays, or
 * all the time. The first time the drawing is seen, its handwriting is revealed line by
 * line, as if it were being written. With "reduce motion", or without JavaScript, nothing
 * moves and the handwriting is all there.
 */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import type { ArtworkEntry } from '../../lib/content/collections';
import {
  DEFAULT_DRIFT_DISTANCE,
  type DrawingAnimation,
  insetOf,
  pivotOrigin,
  writingLines,
} from '../../lib/animations/drawing-animation';

interface Props {
  artwork: ArtworkEntry;
  animation: DrawingAnimation;
  sizes: string;
  widths: number[];
  loading: 'lazy' | 'eager';
  class?: string;
}

const { artwork, animation, sizes, widths, loading, class: className } = Astro.props;

const layerFiles = import.meta.glob<{ default: ImageMetadata }>(
  '../../assets/animations/*/*.webp',
  { eager: true },
);
function layer(name: string): ImageMetadata {
  const file = layerFiles[`../../assets/animations/${animation.artworkId}/${name}.webp`];
  if (file === undefined) {
    throw new Error(
      `Layer "${name}" of the animation of "${animation.artworkId}" is missing: run npx tsx scripts/animations/build.ts`,
    );
  }
  return file.default;
}

const lines = writingLines(animation);
const aspect = `${String(animation.width)} / ${String(animation.height)}`;
const image = { widths, sizes, loading };
---

<animated-drawing
  class:list={['drawing', className]}
  style={`aspect-ratio: ${aspect}`}
  data-trigger={animation.trigger}
>
  <Image class="layer background" src={layer('background')} alt={artwork.data.alt} {...image} />
  {animation.parts.map((part) => (
    <span
      class="window"
      style={
        part.window === undefined ? undefined : `clip-path: ${insetOf(animation, part.window)}`
      }
    >
      <Image
        class={`layer part ${part.motion}`}
        src={layer(part.name)}
        alt=""
        {...image}
        data-part={part.name}
        style={`transform-origin: ${pivotOrigin(animation, part)}; --cycle: ${String(part.seconds)}s; --distance: ${String(part.distance ?? DEFAULT_DRIFT_DISTANCE)}%`}
      />
    </span>
  ))}
  {lines.map((line) => (
    <Image
      class="layer ink-line"
      src={layer('writing')}
      alt=""
      {...image}
      style={`--written: ${line.written}; --blank: ${line.blank}; --delay: ${String(line.delayMs)}ms; --duration: ${String(line.durationMs)}ms`}
    />
  ))}
</animated-drawing>

<script>
  import './animated-drawing';
</script>

<style>
  .drawing {
    display: block;
    position: relative;
    overflow: hidden;
    background: var(--paper);
  }
  .layer {
    display: block;
    width: 100%;
    height: auto;
  }
  .window,
  .part,
  .ink-line {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .ink-line {
    clip-path: var(--written);
  }

  @media (prefers-reduced-motion: no-preference) {
    [data-moving] .strum {
      animation: strum var(--cycle) ease-in-out infinite;
    }
    [data-moving] .sway {
      animation: sway var(--cycle) ease-in-out infinite;
    }
    [data-moving] .drift {
      animation: drift var(--cycle) ease-in-out infinite alternate;
    }
  }
  /* Not yet written before the script runs, so the handwriting never shows and then vanishes. */
  @media (prefers-reduced-motion: no-preference) and (scripting: enabled) {
    .drawing:not([data-written]) .ink-line {
      clip-path: var(--blank);
    }
    [data-writing] .ink-line {
      animation: write var(--duration) linear var(--delay) both;
    }
  }

  @keyframes strum {
    0%,
    100% {
      transform: rotate(0deg);
    }
    35% {
      transform: rotate(-6deg);
    }
    70% {
      transform: rotate(2deg);
    }
  }
  @keyframes sway {
    0%,
    100% {
      transform: rotate(0deg);
    }
    50% {
      transform: rotate(-4deg);
    }
  }
  @keyframes drift {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(var(--distance));
    }
  }
  @keyframes write {
    from {
      clip-path: var(--blank);
    }
    to {
      clip-path: var(--written);
    }
  }
</style>
