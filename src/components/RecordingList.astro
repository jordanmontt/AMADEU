---
/**
 * Recordings of a text or a collection (RF-17), each with a button that plays it in the
 * persistent player and one that adds it to the queue (RF-48). The primary version is
 * highlighted.
 *
 * Audio-only content needs a transcript, not captions (WCAG 1.2.1): the lyrics. On a text
 * page they are next to the list; elsewhere each recording links to its text, and so does
 * its title in the player.
 */
import { es } from '../i18n/es';
import type { Credit } from '../lib/catalog';
import type { RecordingEntry } from '../lib/content/collections';
import { formatArchiveDate, formatDuration } from '../lib/format';
import { recordingTrack } from '../lib/player/track';
import PlayerButton from './player/PlayerButton.astro';

export interface TextLink {
  readonly title: string;
  readonly href: string;
}

interface Props {
  recordings: readonly RecordingEntry[];
  /** Id of the recording shown as the primary version. */
  primaryId?: string | undefined;
  label: string;
  /** Links to the texts each recording is a version of, by recording id. */
  texts?: ReadonlyMap<string, readonly TextLink[]>;
  /** Who did what on each recording, by recording id (RF-17). */
  credits?: ReadonlyMap<string, readonly Credit[]>;
  /** The page of the lyrics of every recording in the list (on a text page). */
  textHref?: string;
  /**
   * Whether playing one recording goes on with the following ones, like an album. Versions
   * of one song are not continuous; a collection is.
   */
  continuous?: boolean;
}

const {
  recordings,
  primaryId,
  label,
  texts = new Map<string, readonly TextLink[]>(),
  credits = new Map<string, readonly Credit[]>(),
  textHref,
  continuous = false,
} = Astro.props;
const tracks = recordings.map((recording) =>
  recordingTrack(recording, textHref ?? texts.get(recording.id)?.[0]?.href),
);

/** Performers and credits in one line: "Marcelo de Urioste, voz y guitarra. Dirección musical: Ana Pérez." */
function people(recording: RecordingEntry): string | undefined {
  const { performers } = recording.data;
  const parts = [
    performers.length > 0 ? performers.join(', ') : undefined,
    ...(credits.get(recording.id) ?? []).map(({ role, name }) => es.recording.credit(role, name)),
  ].filter((part) => part !== undefined);
  return parts.length > 0 ? `${parts.join('. ')}.` : undefined;
}

function details(recording: RecordingEntry): string {
  const { collection, date } = recording.data;
  return [collection, date === undefined ? undefined : formatArchiveDate(date)]
    .filter((part) => part !== undefined)
    .join(', ');
}
---

<ul class="recordings" aria-label={label}>
  {recordings.map((recording, index) => {
    const versionOf = texts.get(recording.id) ?? [];
    const { title } = recording.data;
    return (
      <li class:list={{ primary: recording.id === primaryId }}>
        <PlayerButton
          action="play"
          tracks={continuous ? tracks : tracks.slice(index, index + 1)}
          start={continuous ? index : 0}
          label={es.recording.play(title)}
          pauseLabel={es.recording.pause(title)}
        />
        <div class="about">
          <strong>{title}</strong>
          <span>
            {recording.id === primaryId && `${es.recording.primary}. `}
            {details(recording)}
          </span>
          {people(recording) !== undefined && <span>{people(recording)}</span>}
          {versionOf.length > 0 && (
            <span>
              {es.listen.versionOf}{' '}
              {versionOf.map((text, linkIndex) => (
                <>
                  {linkIndex > 0 && ', '}
                  <a href={text.href}>{text.title}</a>
                </>
              ))}
            </span>
          )}
        </div>
        <span class="duration">{formatDuration(recording.data.durationSeconds)}</span>
        <PlayerButton
          action="enqueue"
          tracks={tracks.slice(index, index + 1)}
          label={es.recording.enqueue(title)}
          text={es.recording.enqueueShort}
          variant="quiet"
          class="enqueue"
        />
      </li>
    );
  })}
</ul>

<style>
  .recordings {
    display: grid;
    gap: 0.6rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  li {
    display: grid;
    grid-template-columns: auto 1fr auto auto;
    align-items: center;
    gap: 0.4rem 1rem;
    padding: 0.75rem 0.9rem;
    border: 2px solid var(--ink);
  }
  li.primary {
    background: var(--sky);
  }
  .about strong {
    display: block;
    font-weight: 600;
  }
  .about span {
    display: block;
  }
  .about span,
  .duration {
    color: var(--ink-soft);
    font-size: 0.95rem;
  }
  .duration {
    font-variant-numeric: tabular-nums;
  }
  @media (max-width: 520px) {
    li {
      grid-template-columns: auto 1fr auto;
    }
    li :global(.enqueue) {
      grid-column: 2 / -1;
      justify-self: start;
    }
  }
</style>
