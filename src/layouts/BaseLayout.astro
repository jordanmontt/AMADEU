---
/**
 * Page shell: language, metadata, skip link (WCAG 2.4.1), header, footer and the persistent
 * audio player. Navigation between pages is client-side (Astro's ClientRouter), which keeps
 * the player sounding across pages (RF-47, ADR 0049).
 */
import { ClientRouter } from 'astro:transitions';
import AudioPlayer from '../components/player/AudioPlayer.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { es } from '../i18n/es';
import '../styles/base.css';

interface Props {
  /** Page title, without the site name. Omit on the home page. */
  title?: string;
  description?: string | undefined;
  /** Keep the page out of search engines (admin pages). */
  noindex?: boolean;
}

const { title, description = es.site.tagline, noindex = false } = Astro.props;
const fullTitle = title === undefined ? es.site.name : `${title} · ${es.site.name}`;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{fullTitle}</title>
    <ClientRouter />
  </head>
  <body>
    <a class="skip-link" href="#content">
      {es.site.skipToContent}
    </a>
    <SiteHeader />
    <main id="content" data-pagefind-body={noindex ? undefined : ''}>
      <slot />
    </main>
    <SiteFooter />
    <AudioPlayer />
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    left: -9999px;
    z-index: 10;
    background: var(--paper);
    padding: 0.5rem 1rem;
  }
  .skip-link:focus {
    left: 1rem;
    top: 1rem;
  }
</style>
