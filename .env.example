# Folder with the content collections (tests use tests/fixtures/content).
CONTENT_DIR=src/content

# The site's public address, for the sitemap, canonical links and shared images. Leave empty
# locally; CI sets it from the repository variable SITE_URL when deploying.
SITE_URL=

# GoatCounter site code (e.g. marcelo-urioste for marcelo-urioste.goatcounter.com). Leave empty
# to count nothing; CI sets it from the repository variable GOATCOUNTER_CODE when deploying.
PUBLIC_GOATCOUNTER_CODE=
