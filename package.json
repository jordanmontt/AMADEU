{
  "name": "amadeu",
  "description": "Archivo Marcelo de Urioste — digital archive of Marcelo de Urioste's work",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist && tsx scripts/pwa/service-worker.ts dist",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "build:e2e": "CONTENT_DIR=tests/fixtures/content SITE_URL=http://localhost:4329 PUBLIC_GOATCOUNTER_CODE=archivo-prueba astro build --outDir dist-e2e && pagefind --site dist-e2e && tsx scripts/pwa/service-worker.ts dist-e2e",
    "test:e2e": "playwright test",
    "verify": "npm run check && npm run lint && npm run format:check && npm run test:coverage && npm run build"
  },
  "dependencies": {
    "@fontsource-variable/literata": "^5.3.0",
    "@fontsource/young-serif": "^5.3.0",
    "astro": "^7.4.13",
    "photoswipe": "^5.4.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^10.15.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "globals": "^17.14.0",
    "pagefind": "^1.6.0",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.1.1",
    "workbox-build": "^7.4.1",
    "yaml": "^2.9.1"
  }
}
